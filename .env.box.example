# Box environment. Copy this file to `.env` in the repo root and fill it in;
# docker compose reads `.env` automatically. `.env` is gitignored: NEVER
# commit it, it holds the real secrets.
#
# On the box these are the ONLY values needed to run (docs/box-deploy.md).
# The frontend is a static build: nothing here is secret, build-time
# VITE_* knobs for `npm run build` are in .env.example.

# ---- Postgres (db service) -------------------------------------------------
# Password for the `postgres` role. Make it long and random:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Connection string for the game server (and the ops scripts when they run in
# the server container). Keep the host as `db`: Docker resolves it on the
# compose network. Replace <PW> below with the exact POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://postgres:<PW>@db:5432/postgres

# ---- Public address (caddy service) -----------------------------------------
# The campaign domain, already pointed at this box (Cloudflare proxy ON).
# Caddy requests the TLS certificate for it by itself. For local testing
# without a domain, use: SITE_ADDRESS=:80
SITE_ADDRESS=goldrush.example.com

# Bcrypt hash that gates /logs (Dozzle: live container logs in a browser, docs/layers.md
# D1). Generate it with:
#   docker run --rm caddy:2 caddy hash-password --plaintext '<your chosen password>'
# Paste the whole output (starts with $2a$ or $2b$) here as one line, but DOUBLE every $
# (docker compose re-interpolates .env values that flow into a ${VAR} in docker-compose.yml,
# so a lone $ in the hash gets treated as the start of another variable reference and
# silently dropped). Example: a hash of $2a$14$abc becomes $$2a$$14$$abc in this file. In
# production, Cloudflare Access in front of /logs is the recommended alternative to this
# password - see docs/box-deploy.md.
DOZZLE_PASSWORD_HASH=

# ---- Game server (server service) -------------------------------------------
# Port the server listens on inside its container. Caddy proxies to it; keep
# 8787 unless the Caddyfile changes with it.
PORT=8787

# Finnhub API token - primary XAU/USD price source (finnhub.io, free tier).
# Leave empty to run on the PAXG fallbacks only (dev).
FINNHUB_TOKEN=

# Optional: take Finnhub through the gold price relay (relay/server.js) instead of opening a
# socket here. A Finnhub key allows ONE socket; the relay holds it and fans the ticks out, so
# several game servers (or a second instance for a side-by-side demo) share one key. When set,
# FINNHUB_TOKEN is not used by this server (give the key to the relay instead). Example:
# FEED_RELAY_WS=ws://host.docker.internal:8788/ws
FEED_RELAY_WS=

# MT5 broker feed (docs/mt5-feed.md) - highest-priority price source, above
# Finnhub. Only used when BOTH METAAPI_TOKEN and METAAPI_ACCOUNT_ID are set;
# leave both empty to run without it. MetaApi.cloud account token.
METAAPI_TOKEN=

# MetaApi account id for the xChief investor (read-only) MT5 login, added to
# that MetaApi account beforehand.
METAAPI_ACCOUNT_ID=

# Broker symbol for XAU/USD on that MT5 server. Defaults to XAUUSD if left
# empty; some brokers use a suffix (XAUUSD.) or a different name (GOLD) -
# confirm on the server before hooking this up.
METAAPI_SYMBOL=

# Secret for signing player tokens (HMAC). Any long random string, >=32 chars:
#   openssl rand -hex 32
# Rotating it invalidates every logged-in player.
PLAYER_TOKEN_SECRET=

# Elastic Mail API key, used to send login (OTP) emails. Leave empty in dev:
# codes are then captured in the dev_otps table, see `npm run otp:peek`.
ELASTIC_API_KEY=

# Sender address for OTP emails (an address verified in your Elastic account).
OTP_SENDER=

# Elastic Mail template id for the $100 gift-card claim email (docs/email-gift-card-template.md
# has the template file and what to send the admin). Leave empty until the admin has set it up
# and sent back the id: sendClaimCode then falls back to a plain-text body instead of failing.
ELASTIC_CLAIM_TEMPLATE_ID=

# Trust CF-Connecting-IP / X-Forwarded-For for the per-IP rate limits (server/limits.js,
# ticket S2). Caddy sits behind Cloudflare on the box, so this stays 1 in production - only
# set it to 0 if the server ever takes traffic with no proxy in front of it (a direct
# connection then falls back to the raw socket address, which the proxy headers cannot
# spoof around).
TRUST_PROXY=1

# Optional: where the server posts a short alert when the price feed goes silent for 60 s
# or the server (re)starts (docs/layers.md D1). A ntfy.sh topic is the easiest option - no
# account, just a free phone app subscribed to a topic URL like
# https://ntfy.sh/xchief-goldrush-<random>. A Slack/Discord incoming webhook URL also
# works. Leave empty to only log alerts to the container's own logs.
ALERT_WEBHOOK_URL=


# Optional Telegram bot for phone alerts (ticket T1). Create the bot with @BotFather, add it to
# a group, then find the chat id with https://api.telegram.org/bot<token>/getUpdates. Leave both
# empty to disable Telegram alerts (ALERT_WEBHOOK_URL above is independent and also optional).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Build-time value for the client (npm run build reads it): 'auto' = same origin as the page, via Caddy at /ws.
VITE_GAME_WS=auto

# --- MT5 bridge route (mt5/, docs/mt5-feed.md "Bridge route") ---
# Alternative to METAAPI_TOKEN/METAAPI_ACCOUNT_ID: our own MT5-under-Wine
# terminal + bridge instead of the hosted MetaApi source. Only takes effect
# when METAAPI_TOKEN is unset (MetaApi wins if both are configured). Start it
# with `docker compose --profile mt5 up`.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=XAUUSD
MT5_BRIDGE_WS=ws://mt5:8765

# KasmVNC login for the mt5 container's one-time first-login step
# (docs/mt5-feed.md "Bridge route" -> "First login"). CUSTOM_USER is only a
# label (KasmVNC has one interactive user); PASSWORD gates the web UI at
# https://127.0.0.1:3001 - leaving it empty leaves that UI unauthenticated,
# so always set it even though the port is loopback-only. Long random string:
#   openssl rand -hex 16
CUSTOM_USER=operator
PASSWORD=

# --- Instagram follow reward (ticket K3, BoxAPI data API) ---
# When BOXAPI_TOKEN is set, the "Follow on Instagram" task becomes active; the server verifies the
# follow by reading BoxAPI (docs/boxapi-instagram-data-api.md). BOXAPI_BASE must be exactly the
# path below. INSTAGRAM_HANDLE is the account players must follow (no leading @).
BOXAPI_TOKEN=
BOXAPI_BASE=https://boxapi.ir/api/instagram/
INSTAGRAM_HANDLE=xchief.global
INSTAGRAM_PROFILE_URL=https://www.instagram.com/xchief.global/
