{
  "name": "xchief-gold-rush",
  "private": true,
  "version": "1.1.0",
  "description": "xChief Gold Rush: a 5-second gold up/down prediction game with live XAU/USD prices, combo multipliers, refill tasks and a leaderboard. Built for the xChief booth at Forex Expo Dubai 2026.",
  "type": "module",
  "homepage": "https://xchief-gold-rush.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/apsych00/xchief-gold-rush.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/economy.test.mjs",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:db",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "relay": "node relay/server.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supabase": "^2.117.0",
    "vercel": "^59.17.0",
    "vite": "^6.0.0"
  }
}
