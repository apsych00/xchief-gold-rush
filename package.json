{
  "name": "xchief-gold-rush",
  "private": true,
  "version": "1.1.0",
  "description": "xChief Gold Rush: a 5-second gold up/down prediction game with live XAU/USD prices, combo multipliers, refill tasks and a leaderboard. Built for the xChief booth at Forex Expo Dubai 2026.",
  "type": "module",
  "homepage": "https://xchief-gold-rush.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/apsych00/xchief-gold-rush.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/economy.test.mjs",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:feed": "node --test test/unit/feed.test.mjs",
    "test:db": "supabase test db",
    "db:test": "bash db/run-tests.sh",
    "test:integration": "node --test \"test/integration/*.test.mjs\"",
    "test:server": "node --test --test-concurrency=1 \"test/integration-box/*.test.mjs\"",
    "test:e2e": "playwright test",
    "server": "node server/index.js",
    "demo": "node demo/run-demo.mjs",
    "load": "node demo/load.mjs",
    "test:all": "npm run test:unit && npm run test:db",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "relay": "node relay/server.js",
    "kiosk:new": "node scripts/gen-kiosk.mjs",
    "kiosk:revoke": "node scripts/revoke-kiosk.mjs",
    "kiosk:list": "node scripts/list-kiosks.mjs",
    "coupons:export": "node scripts/export-coupons.mjs",
    "coupons:load": "node scripts/load-coupons.mjs",
    "otp:peek": "node scripts/peek-otp.mjs",
    "box:up": "docker compose up -d --build",
    "box:ps": "docker compose ps",
    "box:logs": "docker compose logs -f server",
    "box:kiosk:new": "docker compose exec server node scripts/gen-kiosk.mjs",
    "box:kiosk:revoke": "docker compose exec server node scripts/revoke-kiosk.mjs",
    "box:kiosk:list": "docker compose exec server node scripts/list-kiosks.mjs",
    "box:coupons:export": "docker compose exec server node scripts/export-coupons.mjs",
    "box:coupons:load": "docker compose run --rm -v $PWD:/work:ro --workdir /work server node scripts/load-coupons.mjs",
    "box:otp:peek": "docker compose exec server node scripts/peek-otp.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supabase": "^2.117.0",
    "vercel": "^59.17.0",
    "vite": "^6.0.0"
  }
}
