# Price relay (relay/server.js) WebSocket address, e.g. wss://xchief-gold-relay.fly.dev/ws
# When set, every player gets the broker XAU/USD feed through one shared
# upstream connection. Leave empty to have each browser connect on its own.
VITE_RELAY_URL=

# Finnhub API key (free tier works). Enables the real XAU/USD broker feed
# (OANDA / IC Markets) directly from the browser. Note: one key = one open
# connection, so with many simultaneous players use the relay instead.
VITE_FINNHUB_TOKEN=

# Optional: server-side webhook that receives every email lead as JSON.
LEAD_WEBHOOK_URL=
