# ---- price feed ----
# Price relay (relay/server.js) WebSocket address, e.g. wss://xchief-gold-relay.fly.dev/ws
VITE_RELAY_URL=
# Finnhub API key for the direct browser XAU/USD feed (one connection per key; use the relay for many players)
VITE_FINNHUB_TOKEN=

# ---- refill tasks ----
# 'timer' (online: Done unlocks after 15 s) or 'pin' (expo: booth staff also enters the PIN)
VITE_TASK_VERIFY=timer
VITE_STAFF_PIN=1234
# Optional MP4/WebM promo video for the "watch video" task; blank = 15 s branded countdown
VITE_PROMO_VIDEO_URL=
# Social / review / demo links used by the tasks
VITE_LINK_INSTAGRAM=https://www.instagram.com/xchief
VITE_LINK_TELEGRAM=https://t.me/xchief
VITE_LINK_YOUTUBE=https://www.youtube.com/@xchief
VITE_LINK_TRUSTPILOT=https://www.trustpilot.com/review/xchief.com
VITE_LINK_GOOGLE_REVIEW=
VITE_LINK_FPA=https://www.forexpeacearmy.com/forex-reviews/xchief
VITE_LINK_DEMO=https://www.xchief.com/
VITE_SHARE_URL=https://xchief-gold-rush.vercel.app

# ---- leads ----
# Server-side webhook that receives every email lead as JSON (optional)
LEAD_WEBHOOK_URL=

# ---- Afghanistan landing (/af/) ----
# Registration link behind every CTA on the landing (default: campaign link from the design)
VITE_AF_REGISTER_URL=
